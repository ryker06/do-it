{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(eas:*)",
      "Bash(vercel:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f*)",
      "Bash(git reset*--hard*origin*)",
      "Bash(sudo*)",
      "Bash(chmod -R 777*)",
      "Bash(curl*|*sh*)",
      "Bash(wget*|*sh*)"
    ]
  }
}
